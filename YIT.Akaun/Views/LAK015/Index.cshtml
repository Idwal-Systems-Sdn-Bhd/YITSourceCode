@model YIT.Akaun.Models.ViewModels.Forms.PrintFormModel

@{
    ViewData["Title"] = "LAK015 Laporan SiBerhutang";
    Layout = "~/Views/Shared/_Layout.cshtml";

    int year = DateTime.Now.Year;
    DateTime firstDay = new DateTime(year, 1, 1);
    DateTime lastDay = new DateTime(year, 12, 31);
}

<script>
    $(document).ready(function () {

        $("body").on("click", "#btnExportExcel", function () {
            $(".loading").css("display", "");
            $("#btnExportExcel").prop('disabled', true);

            var kodLaporan = $("input[name='kodLaporan']:checked").val();
            var AkCartaId = $('#AkCartaId').val();
            var AkCartaId1 = $('#AkCartaId1').val();
            var Tahun1 = $('#Tahun1').val();

            if (kodLaporan != "") {
                $.ajax({
                    type: "POST",
                    url: '@Url.Action("ExportExcel", "LAK015")',
                    data: { kodLaporan: kodLaporan, AkCartaId: AkCartaId, AkCartaId1: AkCartaId1, Tahun1: Tahun1 },
                    dataType: "json",
                    success: function (r) {
                        window.location = "@Url.Action("Download", "Account")?fileGuid=" + r.fileGuid + "&filename=" + r.fileName;
                        toastr.success("Laporan berjaya dijana.", "Berjaya");
                        toastr.options.timeOut = 5000; // 2s
                        $("#btnExportExcel").prop('disabled', false);
                        $(".loading").css("display", "none");
                    }
                });
            }
        });
    });
</script>

<div class="container">
    <div class="card box-shadow">
        <div class="card-body">
            <div class="row">
                <div class="col-8">
                    <h5 class="text-uppercase text-info mb-0">@ViewData["Title"]</h5>
                    <span class="ac-ref">Indeks</span>
                </div>
                <div class="col-4 text-right"></div>
            </div>
            <hr class="mt-2" />
            <form asp-action="PRINT">
                <div class="card mb-2">
                    <div class="card-body">
                        <div class="form-group col-sm">
                            <div class="custom-control custom-radio pb-2">
                                <input class="custom-control-input" type="radio" asp-for="kodLaporan" id="LAK01501" value="LAK01501" checked>
                                <label class="custom-control-label" for="LAK01501">
                                    Laporan SiBerhutang (Setahun)
                                </label>
                            </div>
                            <div class="custom-control custom-radio pb-2">
                                <input class="custom-control-input" type="radio" asp-for="kodLaporan" id="LAK01502" value="LAK01502">
                                <label class="custom-control-label" for="LAK01502">
                                    Laporan SiBerhutang (Setengah Tahun Pertama)
                                </label>
                            </div>
                            <div class="custom-control custom-radio pb-2">
                                <input class="custom-control-input" type="radio" asp-for="kodLaporan" id="LAK01503" value="LAK01503">
                                <label class="custom-control-label" for="LAK01503">
                                    Laporan SiBerhutang (Setengah Tahun Kedua)
                                </label>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="card">
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-2">
                                <div class="input-group mb-2 input-group-sm ">
                                    <label class="form-control-label">Kod Akaun</label>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="input-group mb-2 input-group-sm ">
                                    <select class="form-control form-control-sm select2" name="AkCartaId" id="AkCartaId" asp-items="@ViewBag.AkCarta"></select>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="input-group mb-2 input-group-sm ">
                                    <select class="form-control form-control-sm select2" name="AkCartaId1" id="AkCartaId1" asp-items="@ViewBag.AkCarta"></select>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-2">
                                <div class="input-group mb-2 input-group-sm ">
                                    <label class="form-control-label">Tahun</label>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="input-group mb-2 input-group-sm ">
                                    <input class="form-control form-control-sm" type="text" name="Tahun1" id="Tahun1" value="@ViewData["Tahun1"]" pattern="^\d{4}" required />
                                    <label class="invalid-feedback">Sila isi ruangan ini.</label>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <hr />

                <div class="form-group text-right">
                    <input type="submit" value="Cetak" id="btnCetak" formtarget="_blank" class="btn ac-primary" />
                    <button type="button" formtarget="_blank" id="btnExportExcel" class="btn ac-info">Jana Excel</button>
                    <span class="loading" style="padding-right:3px; padding-top: 3px; display:inline-block;">
                        <img src="~/img/Spinner.gif" style="height:40px;">
                    </span>
                </div>
            </form>
        </div>
    </div>
</div>