@model YIT.Akaun.Models.ViewModels.Forms.PrintFormModel

@{
    ViewData["Title"] = "LAK008 Laporan Penerimaan Mengikut Julat Tertentu";
    Layout = "~/Views/Shared/_Layout.cshtml";

    int year = DateTime.Now.Year;
    DateTime firstDay = new DateTime(year, 1, 1);
    DateTime lastDay = new DateTime(year, 12, 31);
}


    <script>
        $(document).ready(function () {
            function toggleSusunanInput() {
                if ($('#LAK00801A').is(':checked')) {
                    $('#susunan').removeAttr('disabled');
                } else {
                    $('#susunan').attr('disabled', 'disabled');
                }
            }

            // Add click event listeners for radio buttons
            $('#LAK00802, #LAK00801A, #LAK00803').click(toggleSusunanInput);

        toggleSusunanInput();

        $("body").on("click", "#btnExportExcel", function () {
            $(".loading").css("display", "");
        $("#btnExportExcel").prop('disabled', true);

        var kodLaporan = "";
        if ($('#LAK00801A').is(':checked')) {
            kodLaporan = "LAK00801A";
                } else if ($('#LAK00802').is(':checked')) {
            kodLaporan = "LAK00802";
                } else if ($('#LAK00803').is(':checked')) {
            kodLaporan = "LAK00803";
                }

        var susunan = $("#susunan").val(); 

        // Modify kodLaporan based on susunan selection for LAK00801A
        if (kodLaporan === "LAK00801A") {
                    if (susunan === "Tarikh") {
            kodLaporan = "LAK00801A_Tarikh";
                    } else if (susunan === "Akaun") {
            kodLaporan = "LAK00801A_Akaun";
                    }
                }

        var tarDari1 = $('#tarDari1').val();
        var tarHingga1 = $('#tarHingga1').val();
        var AkBankId = $('#AkBankId').val();
        var jCawanganId = $('#jCawanganId').val();


        if (kodLaporan !== "") {
            $.ajax({
                type: "POST",
                url: '@Url.Action("ExportExcel", "LAK008")',
                data: { kodLaporan: kodLaporan, tarDari1: tarDari1, tarHingga1: tarHingga1, susunan: susunan, AkBankId: AkBankId, jCawanganId: jCawanganId },
                dataType: "json",
                success: function (response) {
                    window.location = "@Url.Action("Download", "Account")?fileGuid=" + response.fileGuid
                        + "&filename=" + response.fileName;
                    toastr.success("Laporan berjaya dijana.", "Berjaya");
                    toastr.options.timeOut = 2000; // 2 seconds
                    $("#btnExportExcel").prop('disabled', false);
                    $(".loading").css("display", "none");
                },
                error: function () {
                    toastr.error("Terdapat masalah semasa menjana laporan.", "Ralat");
                    $("#btnExportExcel").prop('disabled', false);
                    $(".loading").css("display", "none");
                }
            });
                } else {
            toastr.warning("Sila pilih jenis laporan yang sah.", "Amaran");
        $("#btnExportExcel").prop('disabled', false);
        $(".loading").css("display", "none");
                }
            });
        });
</script>




<div class="container">
    <div class="card box-shadow">
        <div class="card-body">
            <div class="row">
                <div class="col-8">
                    <h5 class="text-uppercase text-info mb-0">@ViewData["Title"]</h5>
                    <span class="ac-ref">Indeks</span>
                </div>
                <div class="col-4 text-right">
                </div>

            </div>
            <hr class="mt-2" />
            <form asp-action="PrintPDF">
                <div class="card mb-2">
                    <div class="card-body">
                        <div class="form-group col-sm">
                            <div class="custom-control custom-radio d-inline pb-2" style="padding-right: 50px">
                                <input class="custom-control-input" type="radio" asp-for="kodLaporan" id="LAK00801A" value="LAK00801A" checked>
                                <label class="custom-control-label" for="LAK00801A">
                                    01 - Mengikut Tarikh
                                </label>
                            </div>
                            <div class="custom-control custom-radio d-inline pb-2" style="padding-right: 50px">
                                <input class="custom-control-input" type="radio" asp-for="kodLaporan" id="LAK00802" value="LAK00802">
                                <label class="custom-control-label" for="LAK00802">
                                    02 - Mengikut Daerah
                                </label>
                            </div>
                            <div class="custom-control custom-radio d-inline pb-2" style="padding-right: 50px">
                                <input class="custom-control-input" type="radio" asp-for="kodLaporan" id="LAK00803" value="LAK00803">
                                <label class="custom-control-label" for="LAK00803">
                                    03 - Kemasukan ke Bank
                                </label>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="card mb-2">
                    <div class="card-body">
                        <div class="form-group row g-3">
                            <label for="Tarikh" class="col-sm-2 col-form-label">Tarikh</label>
                            <div class="col-sm-3">
                                <input type="date" class="form-control form-control-sm" id="tarDari1" asp-for="tarDari1" value="@firstDay.ToString("yyyy-MM-dd")">
                            </div>
                            <div class="col-sm-3">
                                <input type="date" class="form-control form-control-sm" id="tarHingga1" asp-for="tarHingga1" value="@lastDay.ToString("yyy-MM-dd")">
                            </div>
                                <label for="Susunan" class="col-sm-1 col-form-label">Susunan</label>
                                <div class="col-sm-2">
                                <select class="form-control form-control-sm" id="susunan" name="susunan" asp-for="susunan" disabled>
                                    <option value="Tarikh" selected>TARIKH</option>
                                    <option value="Akaun">AKAUN</option>
                                </select>
                                </div>
                         </div>
                                 <div class="row">
                                    <div class="col-md-2">
                                        <label class="form-control-label">Daerah</label>
                                    </div>
                                    <div class="col-md-8">
                                        <div class="input-group mb-2 input-group-sm ">
                                            <select class="form-control form-control-sm select2" id ="jCawanganId" name="jCawanganId" asp-for="jCawanganId" asp-items="@ViewBag.JCawangan"></select>
                                            <label class="invalid-feedback">Sila isi ruangan ini.</label>
                                        </div>
                                    </div>
                                </div>
                              
                                <div class="row">
                                    <div class="col-md-2">
                                        <label class="form-control-label">Bank</label>
                                    </div>
                                    <div class="col-md-8">
                                        <div class="input-group mb-2 input-group-sm ">
                                            <select class="form-control form-control-sm select2" id="AkBankId" name="AkBankId" asp-for="AkBankId" asp-items="@ViewBag.AkBank"></select>
                                            <label class="invalid-feedback">Sila isi ruangan ini.</label>
                                        </div>
                                    </div>
                                </div>
                                </div>
                            </div>
                <div class="card mb-2">
                    <div class="card-body">
                        <div id="sediaContainer" class="row">
                            <div class="col-md-2">
                                <div class="input-group mb-2 input-group-sm">
                                    <label for="dPekerjaId1" class="form-control-label">Disedia</label>
                                </div>
                            </div>
                            <div class="col-md-8">
                                <div class="input-group mb-2 input-group-sm">
                                    <select class="form-control form-control-sm select2" name="dPekerjaId1" asp-items="@ViewBag.DPekerja1" id="dPekerjaId1"></select>
                                    <label class="invalid-feedback">Sila pilih ruangan ini.</label>
                                </div>
                            </div>
                        </div>
                        <div id="semakContainer" class="row">
                            <div class="col-md-2">
                                <div class="input-group mb-2 input-group-sm">
                                    <label for="dPekerjaId2" class="form-control-label">Disemak</label>
                                </div>
                            </div>
                            <div class="col-md-8">
                                <div class="input-group mb-2 input-group-sm">
                                    <select class="form-control form-control-sm select2" name="dPekerjaId2" asp-items="@ViewBag.DPekerja2" id="dPekerjaId2"></select>
                                    <label class="invalid-feedback">Sila pilih ruangan ini.</label>
                                </div>
                            </div>
                        </div>
                        <div id="sahContainer" class="row">
                            <div class="col-md-2">
                                <div class="input-group mb-2 input-group-sm">
                                    <label for="dPekerjaId3" class="form-control-label">Disah</label>
                                </div>
                            </div>
                            <div class="col-md-8">
                                <div class="input-group mb-2 input-group-sm">
                                    <select class="form-control form-control-sm select2" name="dPekerjaId3" asp-items="@ViewBag.DPekerja3" id="dPekerjaId3"></select>
                                    <label class="invalid-feedback">Sila pilih ruangan ini.</label>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <hr />
                <div class="form-group text-right">
                    <input type="submit" value="Cetak" formtarget="_blank" class="btn ac-primary" />
                    <button type="button" formtarget="_blank" id="btnExportExcel" class="btn ac-info">Jana Excel</button>
                    <span class="loading" style="padding-right:3px; padding-top: 3px; display:inline-block;">
                        <img src="~/img/Spinner.gif" style="height:40px;">
                    </span>
                </div>

            </form>
        </div>
    </div>


</div>